+        yy=[info[r["id"]]["type"] for r in kept if r["id"] in info and info[r["id"]]["type"] in ("高钾","铅钡")]
+        cc={c:[mean([xx[i][j] for i in range(len(xx)) if yy[i]==c]) for j in range(len(headers))] for c in set(yy)}
+        labs=[]

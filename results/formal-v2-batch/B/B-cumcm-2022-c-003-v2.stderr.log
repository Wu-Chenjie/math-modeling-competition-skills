+    svg_bar(FIG/"result_q3_sensitivity.svg",[str(s["validity_range"]) for s in sens],[sum(a==b for a,b in zip(sens[1]["unknown_labels"],s["unknown_labels"])) for s in sens],"Unknown-label agreement with 85-105 rule", "#4c956c")
+    labels=headers[:6]

+def mean(xs): return sum(xs) / len(xs) if xs else float("nan")
+def sd(xs):
+    if len(xs) < 2: return 0.0
+    m = mean(xs); return math.sqrt(sum((x-m)**2 for x in xs)/(len(xs)-1))
+def safe_num(x):
+    try: return float(x) if x not in (None, "") else 0.0

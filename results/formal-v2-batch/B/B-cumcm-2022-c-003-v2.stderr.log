+    q1_means={}
+    for key, rows in comp_by_tw.items(): q1_means["|".join(key)]={h:mean([x[i] for x in rows]) for i,h in enumerate(headers)}
+    # Use clr centroids for classification and grouped leave-one-artifact-out validation
+    X=[]; y=[]; groups=[]

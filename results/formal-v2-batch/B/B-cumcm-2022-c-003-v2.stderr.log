+            X.append(clr(r["values"])); y.append(info[r["id"]]["type"]); groups.append(r["id"])
+    cent={c:[mean([X[i][j] for i in range(len(X)) if y[i]==c]) for j in range(len(headers))] for c in sorted(set(y))}
+    def predict(v, cents=cent):

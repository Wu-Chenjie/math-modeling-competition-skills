+def features(rows):
+    X=[]; y=[]
+    for r in rows:
+      age=2020-r['year']; reg=r['region']
+      X.append([1.0,r['length'],age,age*age,1.0 if reg=='Europe' else 0.0,1.0 if reg=='USA' else 0.0]); y.append(math.log(r['price']))
+    return np.asarray(X,float),np.asarray(y,float)

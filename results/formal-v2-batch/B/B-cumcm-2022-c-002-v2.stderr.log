+import json, subprocess, sys
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[1]
+def test_pipeline_outputs_and_constraints():
+    subprocess.run([sys.executable,'run_model.py'],cwd=ROOT,check=True)
+    m=json.loads((ROOT/'results/metrics.json').read_text(encoding='utf-8'))
+    assert m['data_audit']['valid_form2_rows']>0
+    assert m['classification']['n']==m['classification']['class_counts']['高钾']+m['classification']['class_counts']['铅钡']
+    assert 0<=m['classification']['centroid_accuracy']<=1
+    assert len(m['unknown_predictions'])==8
+    assert len(list((ROOT/'figures').glob('*.svg')))>=4


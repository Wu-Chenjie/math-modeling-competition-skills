+    if labels is None: labels=['']*len(xs)
+    for x,y,l in zip(xs,ys,labels):
+        out.append(f'<circle cx="{X(x):.2f}" cy="{Y(y):.2f}" r="4" fill="#1769aa"/>')
+        if l: out.append(f'<text x="{X(x)+6:.2f}" y="{Y(y)-5:.2f}" font-family="Arial" font-size="9">{l}</text>')

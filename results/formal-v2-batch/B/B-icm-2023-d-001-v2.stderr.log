+        ),
+    ]
+    paths = []
+    for filename, title, lines, bars in specs:
+        path = figure_dir / filename
+        path.write_text(_svg(title, lines, bars), encoding="utf-8", newline="\n")
+        paths.append(path)
+    return paths

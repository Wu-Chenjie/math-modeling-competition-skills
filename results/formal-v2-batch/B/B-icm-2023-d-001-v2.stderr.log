+    )
+    goals = [
+        {"id": int(number), "name": " ".join(name.split())}
+        for number, name in matches
+    ]
+    if [goal["id"] for goal in goals] != list(range(1, 18)):
+        raise ValueError("official prompt did not yield exactly SDGs 1 through 17")
+    return goals

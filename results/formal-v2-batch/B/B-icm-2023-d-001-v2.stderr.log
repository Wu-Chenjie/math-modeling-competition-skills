+            [("Official SDG nodes", 17, "#2f6f4e"), ("Data files", 0, "#b23a48"), ("Audited tables", 0, "#b23a48"), ("Relationship rows", 0, "#b23a48")],
+        ),
+        (
+            "process_q1_estimation_gates.svg",

+
+
+def main():
+    summary = json.loads(SUMMARY.read_text(encoding="utf-8"))
+    OUT.mkdir(exist_ok=True)
+    FIG.mkdir(exist_ok=True)
+    input_hash = sha256(SUMMARY)

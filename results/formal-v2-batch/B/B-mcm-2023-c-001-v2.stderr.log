+import json
+from pathlib import Path
+
+import wordle_model as wm
+
+
+CASE = Path(r"C:\Users\伍辰杰\Documents\ChatGPT\mathmodel\math-modeling-competition-skills\benchmarks\case-summaries\mcm-2023-c.json")
+
+
+def test_load_records_ignores_padding_and_parses_percentages():
+    records, audit = wm.load_records(CASE)
+    assert len(records) == 358
+    assert audit["rows_total"] == 481
+    assert records[0]["word"] == "manly"
+    assert abs(sum(records[0]["outcomes"]) - 1.0) < 1e-9
+
+
+def test_word_features_are_deterministic():
+    f = wm.word_features("EERIE")
+    assert f["length"] == 5
+    assert f["unique_letters"] == 3
+    assert f["repeated_letters"] == 2
+    assert f["vowels"] == 4
+
+
+def test_prediction_interval_and_classification_have_expected_shapes():
+    records, _ = wm.load_records(CASE)
+    forecast = wm.forecast_reported(records)
+    assert forecast["point"] > 0
+    assert forecast["lower"] <= forecast["point"] <= forecast["upper"]
+    cls = wm.classify_difficulty(records)
+    assert 0 <= cls["holdout_accuracy"] <= 1
+    assert cls["eerie_label"] in {"easy", "medium", "hard"}

+def generate_weather(years: int, scenario: dict, seed: int) -> dict[str, np.ndarray]:
+    rng = np.random.default_rng(seed)
+    steps = years * 12
+    drought = rng.random(steps) < scenario["drought_rate"]
+    severity = np.zeros(steps)

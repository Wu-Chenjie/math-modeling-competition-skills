+def make_traits(n: int, composition: str = "balanced") -> dict[str, np.ndarray]:
+    if composition == "drought_tolerant":
+        sens = np.linspace(0.20, 0.45, n)
+    elif composition == "drought_sensitive":
+        sens = np.linspace(0.75, 0.95, n)
+    else:

+        "terminal_p10": float(np.quantile(terminal, 0.10)), "minimum_p10": float(np.quantile(minimum, 0.10)),
+        "extinction_probability": float(np.mean([s["extinct"] for s in sims])),
+        "sim": sims[0],
+    }
+
+

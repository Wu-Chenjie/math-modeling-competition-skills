+    "opportunist": {"r": 0.72, "mortality": 0.19, "tol": 0.42, "adapt": 0.030, "loss": 0.010},
+    "generalist": {"r": 0.60, "mortality": 0.14, "tol": 0.65, "adapt": 0.040, "loss": 0.008},
+}
+

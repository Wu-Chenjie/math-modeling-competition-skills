@@ -0,0 +1,54 @@
+import json
+from pathlib import Path
+
+import numpy as np
+
+import model_pipeline as mp
+
+
+CASE = Path(r"C:\Users\伍辰杰\Documents\ChatGPT\mathmodel\math-modeling-competition-skills\benchmarks\case-summaries\mcm-2023-c.json")
+
+
+def test_load_rows_keeps_only_numeric_contest_rows_and_audits_input():
+    data = json.loads(CASE.read_text(encoding="utf-8"))
+    rows, audit = mp.load_rows(data)
+    assert len(rows) == 359
+    assert audit["candidate_rows"] == 359
+    assert audit["omitted_rows"] == 122
+    assert rows[0]["contest"] == 560
+    assert rows[-1]["contest"] == 202
+
+
+def test_word_features_capture_eerie_repetition_and_vowels():
+    f = mp.word_features("EERIE")
+    assert f["length"] == 5
+    assert f["unique_letters"] == 3
+    assert f["vowels"] == 4
+    assert f["repeated_letters"] == 2
+
+
+def test_composition_prediction_is_simplex_and_interval_is_ordered():
+    rows, _ = mp.load_rows(json.loads(CASE.read_text(encoding="utf-8")))
+    frame = mp.build_frame(rows)
+    fit = mp.fit_composition_model(frame)
+    pred, lo, hi = mp.predict_composition(fit, frame, "EERIE", 2023, 3, 1)
+    assert np.isclose(pred.sum(), 1.0)
+    assert np.all(pred >= 0)
+    assert np.all(lo <= pred)
+    assert np.all(pred <= hi)
+
+
+def test_temporal_validation_does_not_shuffle_and_returns_metrics():
+    rows, _ = mp.load_rows(json.loads(CASE.read_text(encoding="utf-8")))
+    frame = mp.build_frame(rows)
+    result = mp.temporal_validation(frame)
+    assert result["folds"] == 5
+    assert result["train_last_contest"] > result["test_last_contest"]
+    assert result["composition_mae"] >= 0
+
+
+def test_pipeline_writes_machine_readable_contract(tmp_path):
+    out = mp.run_pipeline(CASE, tmp_path)
+    assert Path(out["metrics_path"]).exists()
+    assert Path(out["manifest_path"]).exists()
+    assert len(list((tmp_path / "figures").glob("*.svg"))) == 9


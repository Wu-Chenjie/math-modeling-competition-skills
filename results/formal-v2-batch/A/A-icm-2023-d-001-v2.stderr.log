+            elems.append(f'<rect x="{x}" y="{y}" width="{cell}" height="{cell}" fill="{col}" stroke="white" stroke-width="0.4"/>')
+    elems.append('</svg>'); path.write_text("\n".join(elems), encoding="utf-8")
+
+

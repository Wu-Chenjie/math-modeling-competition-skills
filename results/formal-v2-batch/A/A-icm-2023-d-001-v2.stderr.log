+def power_centrality(W, iters=200):
+    v = np.ones(W.shape[0]) / W.shape[0]
+    B = np.abs(W)
+    for _ in range(iters):
+        nv = B @ v
+        nv /= np.linalg.norm(nv) or 1.0
+        if np.max(np.abs(nv - v)) < 1e-12:
+            break
+        v = nv
+    return minmax(v)

+    svg_bar(figures/'raw_q3_degree.svg', np.abs(A).sum(axis=1), SDGS, 'q3 raw: node weighted degree', '#d17a22')
+    svg_bar(figures/'raw_q4_stress.svg', np.abs(A).sum(axis=1), SDGS, 'q4 raw: baseline exposure', '#9b5de5')

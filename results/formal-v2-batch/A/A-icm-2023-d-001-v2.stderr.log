+
+
+def rank_desc(x):
+    return [int(i + 1) for i in np.argsort(-x)]
+
+
+def topsis(criteria, weights):
+    X = np.asarray(criteria, float)
+    denom = np.sqrt((X * X).sum(axis=0, keepdims=True))
+    Z = X / np.maximum(denom, 1e-12)

        "code_path": str(Path(__file__).resolve()),
        "metrics_path": str(metrics_path),
        "figures_count": len(figures),
        "tests": metrics["tests"],
        "pending_stages": [],
    }
    print(json.dumps(receipt, ensure_ascii=False))



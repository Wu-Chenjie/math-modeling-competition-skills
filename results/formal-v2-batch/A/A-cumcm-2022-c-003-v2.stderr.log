+    with (RESULTS/"classification.csv").open("w",newline="",encoding="utf-8") as f:
+        w=csv.writer(f); w.writerow(["id","class","margin","flip_rate_pm1pp"]); [w.writerow([z["id"],z["class"],z["margin"],z["flip_rate_pm1pp"]]) for z in q3]

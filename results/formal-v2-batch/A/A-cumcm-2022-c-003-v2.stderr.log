+RESULTS = ROOT / "results"; FIGURES = ROOT / "figures"
+COMP_NAMES = ["SiO2","Na2O","K2O","CaO","MgO","Al2O3","Fe2O3","CuO","PbO","BaO","P2O5","SrO","SnO2","SO2"]
+SEED = 20220822

+    assert ".xlsx" not in source
+    case = json.loads(Path(r"C:/Users/伍辰杰/Documents/ChatGPT/mathmodel/math-modeling-competition-skills/benchmarks/case-summaries/cumcm-2022-c.json").read_text(encoding="utf-8"))

+def main():
+    case,sheets,input_hash=load_case(); meta,rows,unknown=parse_rows(sheets)
+    valid=[r for r in rows if r["valid"]]; base_samples=[r for r in valid if r["kind"]=="sample"]
+    # q1 grouped rates and composition means

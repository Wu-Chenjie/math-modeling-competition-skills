+            h=q4[labs[0]]["correlation"]
+        svg(FIGURES/f"raw_q{qi}_overview.svg",f"q{qi} raw overview",bars=bars)
+        svg(FIGURES/f"process_q{qi}_model.svg",f"q{qi} model process",points=pts)

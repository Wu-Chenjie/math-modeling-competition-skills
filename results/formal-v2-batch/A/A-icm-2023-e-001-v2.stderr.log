+import json
+import tempfile
+from pathlib import Path
+
+from run_model import build_report, composite_risk, intervention_effect
+
+
+def test_composite_risk_bounds_and_monotonicity():
+    low = composite_risk([0, 0, 0, 0, 0, 0, 0])
+    high = composite_risk([1, 1, 1, 1, 1, 1, 1])
+    more_harm = composite_risk([0.8, 0, 0, 0, 0, 0, 0])
+    assert 0 <= low <= 1
+    assert 0 <= high <= 1
+    assert more_harm > low
+
+
+def test_intervention_reduces_harm_and_preserves_safety_floor():
+    baseline = [0.8, 0.7, 0.6, 0.5, 0.7, 0.8, 0.6]
+    mitigated = intervention_effect(baseline, "adaptive_controls")
+    assert mitigated[0] < baseline[0]
+    assert mitigated[1] < baseline[1]
+    assert mitigated[6] >= 0.4
+
+
+def test_report_flags_missing_rows_without_scores():
+    with tempfile.TemporaryDirectory() as td:
+        out = Path(td)
+        summary = {"case_id": "x", "data_files": [], "data_audit": []}
+        report = build_report(summary, out)
+        assert report["data_audit"]["rows_available"] == 0
+        assert report["validation"]["empirical_status"] == "pending"
+        assert not (out / "results" / "metrics.json").exists()


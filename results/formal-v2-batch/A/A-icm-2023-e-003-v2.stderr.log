+            "exposure_fields": list(EXPOSURE_FIELDS),
+            "vulnerability_fields": list(VULNERABILITY_FIELDS),
+            "service_constraint_field": "lighting_need",
+            "risk_bands": None,
+            "calibration_status": "pending",
+        },

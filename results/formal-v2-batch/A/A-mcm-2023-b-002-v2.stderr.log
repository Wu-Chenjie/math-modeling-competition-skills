+    "corridor": {"wildlife": 0.55, "livelihood": 0.55, "tourism": 0.35, "conflict": 0.50, "capacity": 0.45},
+    "community": {"wildlife": 0.35, "livelihood": 0.85, "tourism": 0.40, "conflict": 0.60, "capacity": 0.80},
+}
+EFFECT = {

+        ("raw", "raw_q2", [BASE[z]["conflict"] for z in ZONES], "Raw zone conflict index", "index"),
+        ("raw", "raw_q3", [BASE[z]["livelihood"] for z in ZONES], "Raw zone livelihood index", "index"),

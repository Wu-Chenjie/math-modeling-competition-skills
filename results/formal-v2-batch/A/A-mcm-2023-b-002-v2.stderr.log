+
+ZONES = ["core", "buffer", "corridor", "community"]
+POLICIES = ["protection", "regulated_tourism", "community_conservancy", "corridor_restoration"]
+BASE = {
+    "core": {"wildlife": 1.00, "livelihood": 0.25, "tourism": 0.55, "conflict": 0.15, "capacity": 0.55},

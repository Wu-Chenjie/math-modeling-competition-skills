+            "experiment",
+            "validation",
+            "sensitivity_robustness",
+            "falsification",
+            "reviewer_risks",
+            "reproducibility_manifest",
+        }
+        self.assertEqual(required, set(report))
+        self.assertEqual(report["data_audit"]["observed_rows"], 0)
+        self.assertTrue(report["data_audit"]["model_generated_values_only"])
+
+

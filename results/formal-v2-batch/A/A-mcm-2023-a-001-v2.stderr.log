+    image = ax.imshow(grid, cmap="magma", aspect="auto")
+    ax.set(xticks=range(4), xticklabels=habitat_levels, yticks=range(4), yticklabels=pollution_levels, xlabel="Habitat fraction", ylabel="Pollution mortality", title="Joint degradation effect")
+    fig.colorbar(image, ax=ax, label="Median long-run biomass")
+    save_figure(fig, figures_dir / "result_q5_joint_degradation.png")
+
+    # q6: management and wider-environment viability proxy
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    management = metrics["experiments"]["management"]

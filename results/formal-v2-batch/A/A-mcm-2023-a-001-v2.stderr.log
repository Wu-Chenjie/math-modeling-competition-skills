+            values.append(metrics["experiments"]["drought_grid"][key][str(s)]["median"])
+        ax.plot(frequencies, values, marker=marker, label=f"S={s}")
+    ax.set(xlabel="Drought-event frequency", ylabel="Median long-run biomass", title="Richness effect changes with drought frequency")
+    ax.legend(frameon=False)
+    save_figure(fig, figures_dir / "result_q4_frequency_by_richness.png")
+
+    # q5: pollution and habitat reduction
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    pollution_levels = (0.00, 0.04, 0.08, 0.12)
+    habitat_levels = (1.00, 0.85, 0.70, 0.55)
+    for habitat in habitat_levels:
+        ax.plot(pollution_levels, [habitat] * 4, "o-", label=f"habitat={habitat:.2f}")
+    ax.set(xlabel="Pollution mortality", ylabel="Habitat fraction", title="Crossed degradation scenario design")
+    ax.legend(frameon=False, ncol=2)
+    save_figure(fig, figures_dir / "raw_q5_degradation_design.png")
+
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    ax.plot(demo["time_years"], demo["total_biomass"], label="reference", color=colors["main"])
+    ax.plot(degraded_demo["time_years"], degraded_demo["total_biomass"], label="pollution + habitat loss", color=colors["accent"])
+    ax.set(xlabel="Year", ylabel="Total biomass", title="Matched-weather degradation trajectory")
+    ax.legend(frameon=False)
+    save_figure(fig, figures_dir / "process_q5_degradation_dynamics.png")
+
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    grid = np.zeros((4, 4))
+    for i, pollution in enumerate(pollution_levels):
+        for j, habitat in enumerate(habitat_levels):
+            key = f"pollution_{pollution:.2f}_habitat_{habitat:.2f}"
+            grid[i, j] = metrics["experiments"]["degradation_grid"][key]["median"]
+    image = ax.imshow(grid, cmap="magma", aspect="auto")
+    ax.set(xticks=range(4), xticklabels=habitat_levels, yticks=range(4), yticklabels=pollution_levels, xlabel="Habitat fraction", ylabel="Pollution mortality", title="Joint degradation effect")
+    fig.colorbar(image, ax=ax, label="Median long-run biomass")
+    save_figure(fig, figures_dir / "result_q5_joint_degradation.png")
+
+    # q6: management and wider-environment viability proxy
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    management = metrics["experiments"]["management"]

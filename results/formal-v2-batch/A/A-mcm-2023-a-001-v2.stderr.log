+    ax.boxplot(data, showfliers=False, widths=0.55)
+    ax.set(xlabel="Species richness", ylabel="Long-run biomass", title="Weather-replicate distribution by richness")
+    save_figure(fig, figures_dir / "process_q2_richness_replicates.png")
+
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))

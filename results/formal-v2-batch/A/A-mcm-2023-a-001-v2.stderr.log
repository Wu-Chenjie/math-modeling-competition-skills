+    ax.bar(x + 0.18, viability_values, width=0.36, label="viability probability", color=colors["green"])
+    ax.set(xticks=x, xticklabels=names, ylabel="Scenario metric", title="Combined intervention dominates single levers")
+    ax.tick_params(axis="x", rotation=24)
+    ax.legend(frameon=False)
+    save_figure(fig, figures_dir / "result_q6_management_priority.png")
+
+    return sorted(path.name for path in figures_dir.glob("*.png"))

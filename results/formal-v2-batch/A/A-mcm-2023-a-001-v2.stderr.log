+    habitat = [management[name]["scenario"]["habitat_fraction"] for name in names]
+    pollution = [management[name]["scenario"]["pollution"] for name in names]
+    x = np.arange(len(names))
+    ax.plot(x, np.array(richness) / 6.0, "o-", label="richness / 6")

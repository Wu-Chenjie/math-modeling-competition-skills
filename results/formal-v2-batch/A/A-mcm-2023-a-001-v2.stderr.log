+    ax.plot(x, 1.0 - np.array(pollution) / 0.12, "^-", label="pollution control")
+    ax.set(xticks=x, xticklabels=names, ylabel="Normalized input", title="Management scenario inputs")
+    ax.tick_params(axis="x", rotation=24)
+    ax.legend(frameon=False, ncol=3)

+            drought = max(0.0, 0.70 - p)
+            weather_factor = max(0.02, p * (1.0 - drought * (1.0 - tolerance)))
+            competition = total / carrying
+            growth = 0.34 * weather_factor * math.exp(-1.25 * pollution)

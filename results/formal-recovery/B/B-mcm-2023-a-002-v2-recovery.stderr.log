+def main():
+    case = json.loads(CASE.read_text(encoding="utf-8"))
+    (ROOT / "results").mkdir(exist_ok=True)
+    (ROOT / "figures").mkdir(exist_ok=True)
+    weather = weather_series(SEED, STEPS)
+    baseline_weather = [0.85] * STEPS

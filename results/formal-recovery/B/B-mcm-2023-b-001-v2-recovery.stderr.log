+    d.line((left, bottom, right, bottom), fill="black", width=2)
+    im.save(path)
+
+
+def _line(path: Path, series, title):
+    w, h = 900, 520
+    im = Image.new("RGB", (w, h), "white")
+    d = ImageDraw.Draw(im)
+    d.text((35, 20), title, fill="black", font=_font(22))

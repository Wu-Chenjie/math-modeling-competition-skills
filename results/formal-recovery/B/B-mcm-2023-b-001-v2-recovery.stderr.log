+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+import model
+
+
+CASE = Path(r"C:\Users\伍辰杰\Documents\ChatGPT\mathmodel\math-modeling-competition-skills\benchmarks\case-summaries\mcm-2023-b.json")

+                "seed": None, "dependencies": {"python": "3.12+", "numpy": "available", "Pillow": "available"}, "outputs": [str(metrics_path), str(report_path)]}
+    (metrics_path.parent / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+

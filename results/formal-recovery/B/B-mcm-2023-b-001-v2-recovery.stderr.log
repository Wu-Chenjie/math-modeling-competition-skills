+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import model
+
+
+CASE = Path(__file__).parent / "case_input.json"
+
+
+def test_case_summary_is_loaded_without_external_data():
+    case = model.load_case(CASE)
+    assert case["case_id"] == "mcm-2023-b"
+    assert case["data_files"] == []
+
+
+def test_evaluate_policy_is_bounded_and_constraint_respecting():
+    case = model.load_case(CASE)
+    result = model.evaluate_policy(case, {"community": 1, "zoning": 1, "levy": 1}, "baseline")
+    assert 0.0 <= result["robust_score"] <= 1.0
+    assert result["capacity_used"] <= result["capacity_limit"]
+    assert set(result["objectives"]) == {"wildlife", "livelihood", "conflict", "cost"}
+
+
+def test_cli_writes_machine_readable_outputs(tmp_path):
+    metrics = tmp_path / "metrics.json"
+    figures = tmp_path / "figures"
+    report = tmp_path / "report.md"
+    proc = subprocess.run(
+        [sys.executable, "model.py", "--case", str(CASE), "--metrics", str(metrics), "--figures", str(figures), "--report", str(report)],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert proc.returncode == 0, proc.stderr
+    payload = json.loads(metrics.read_text(encoding="utf-8"))
+    assert payload["case_id"] == "mcm-2023-b"
+    assert len(list(figures.glob("*.png"))) >= 9
+    assert report.exists()


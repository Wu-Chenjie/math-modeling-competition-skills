+        "final_adaptation": adapts[-1], "min_total": min(totals),
+        "precipitation": precip, "total_series": totals, "adaptation_series": adapts,
+        "drought_series": droughts, "environment_series": env,
+        "sensitivities": sensitivities,
+    }

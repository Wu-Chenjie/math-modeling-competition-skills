+        rows = sweep_species([1, 2, 4], seed=7, days=80)
+        self.assertEqual([r["n_species"] for r in rows], [1, 2, 4])
+        self.assertTrue(all(r["final_total"] >= 0 for r in rows))
+
+
+if __name__ == "__main__":
+    unittest.main()


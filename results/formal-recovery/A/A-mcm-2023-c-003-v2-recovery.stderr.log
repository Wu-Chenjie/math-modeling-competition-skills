+    (out / "modeling_report.md").write_text(report, encoding="utf-8")
+    print(json.dumps({"status": "ok", "rows": n, "forecast": q1["forecast"], "holdout_rmse": q3["holdout_rmse"], "difficulty_accuracy": accuracy}, indent=2))

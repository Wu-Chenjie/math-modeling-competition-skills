+             f'<text x="450" y="32" text-anchor="middle" font-family="Arial" font-size="22">{title}</text>',
+             '<line x1="90" y1="450" x2="850" y2="450" stroke="#222"/>',
+             '<line x1="90" y1="70" x2="90" y2="450" stroke="#222"/>',

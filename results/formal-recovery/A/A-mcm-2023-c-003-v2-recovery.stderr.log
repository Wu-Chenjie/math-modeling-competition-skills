+    ppm = struct.pack(">IIB", 11811, 11811, 1)
+    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"pHYs", ppm) + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b"")
+

+def artifact_id(label: str) -> str:
+    match = re.match(r"(\d+)", str(label))
+    return match.group(1).zfill(2) if match else str(label)
+
+
+def sample_weathering(label: str, surface: str) -> str:
+    if "未风化点" in label:
+        return "无风化"
+    if "严重风化点" in label:
+        return "风化"
+    return surface

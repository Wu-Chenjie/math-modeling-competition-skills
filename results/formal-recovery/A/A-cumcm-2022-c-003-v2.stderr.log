+    chi2 = stats.chi2_contingency(table, correction=False)[0]
+    n = table.sum()
+    phi2 = chi2 / n
+    r, k = table.shape
+    corrected = max(0.0, phi2 - ((k - 1) * (r - 1)) / max(n - 1, 1))
+    rc = r - ((r - 1) ** 2) / max(n - 1, 1)
+    kc = k - ((k - 1) ** 2) / max(n - 1, 1)
+    denom = min(kc - 1, rc - 1)
+    return float(math.sqrt(corrected / denom)) if denom > 0 else None
+

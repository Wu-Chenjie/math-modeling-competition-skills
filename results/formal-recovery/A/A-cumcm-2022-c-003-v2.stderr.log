+def close_composition(values: np.ndarray, replacement: float = 0.01) -> np.ndarray:
+    x = np.asarray(values, dtype=float).copy()
+    x[~np.isfinite(x)] = 0.0
+    x[x <= 0] = replacement
+    return x / x.sum(axis=1, keepdims=True)

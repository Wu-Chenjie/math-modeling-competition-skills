+    ax.set(ylabel="Proportion", title="Q1 weathering by glass type"); ax.legend(frameon=False); save_figure(fig, out / "raw_q1_weathering_type"); logical += 1
+    fig, ax = plt.subplots(figsize=(5.0, 3.0))

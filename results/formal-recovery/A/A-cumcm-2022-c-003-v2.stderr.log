+    pred = cross_val_predict(model, x, y, groups=groups, cv=logo, method="predict")
+    prob = cross_val_predict(model, x, y, groups=groups, cv=logo, method="predict_proba")[:, 1]
+    return pred, prob
+
+
+def fit_classifier(x: np.ndarray, y: np.ndarray):

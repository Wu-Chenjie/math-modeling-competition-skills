+
+def generate_figures(rows: list[dict], valid: list[dict], z: np.ndarray, y: np.ndarray, cv_prob: np.ndarray, subtype: dict[str, int], unknown: list[dict], unknown_prob: np.ndarray, metrics: dict, out: Path) -> int:

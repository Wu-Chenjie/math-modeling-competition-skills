+    # Q1: association and weathering composition contrasts
+    tab = pd.crosstab(f1['类型'], f1['表面风化']); chi2,p,ddof,exp=chi2_contingency(tab)
+    n=tab.values.sum(); cramers=np.sqrt((chi2/n)/min(tab.shape[0]-1,tab.shape[1]-1))
